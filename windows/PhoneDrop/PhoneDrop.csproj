<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PhoneDrop</AssemblyName>
    <RootNamespace>PhoneDrop</RootNamespace>
    <ApplicationIcon>Assets\PhoneDrop.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.2.0</Version>
    <Product>PhoneDrop</Product>
    <Description>Přetáhni soubor nebo APK do okénka a pošli ho do telefonu</Description>
    <SatelliteResourceLanguages>cs;en</SatelliteResourceLanguages>
    <!-- Vlastní prvky se nekreslí v návrháři, serializace vlastností není potřeba. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\PhoneDrop.ico" LogicalName="PhoneDrop.ico" />
  </ItemGroup>

</Project>
